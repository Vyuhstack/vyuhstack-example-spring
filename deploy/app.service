# /etc/systemd/system/app.service
[Unit]
Description=VyuhStack example (Spring Boot)
After=network.target

[Service]
User=vyuh-user
WorkingDirectory=/opt/app
# runs the copy made by the release step, not target/app.jar, so a build never
# overwrites the jar the running app is using
ExecStart=/usr/bin/java -Xmx256m -jar /opt/app/app.jar
SuccessExitStatus=143
Restart=on-failure

[Install]
WantedBy=multi-user.target
